#!/usr/bin/env python3
"""Fail-closed exact-artifact Odoo deployment adapter."""
from __future__ import annotations

import argparse, hashlib, json, os, shutil, socket, stat, subprocess, tarfile, tempfile, time
import urllib.parse, urllib.request
from pathlib import Path

SHA256="sha256:"; CONFIG_ROOT=Path("/etc/codestra/odoo-deploy-targets"); EVIDENCE_ROOT=Path("/etc/codestra/deployment-evidence/sha256")
MAX_ARCHIVE_BYTES=64*1024*1024; MAX_EXPANDED_BYTES=128*1024*1024; MAX_MEMBER_BYTES=32*1024*1024; MAX_MEMBERS=4096; MAX_OPERATION_SECONDS=300; MAX_HEALTH_BYTES=64*1024
NO_SEND_KEYS={"ENABLE_EXTERNAL_DELIVERY":"false","EMAIL_DELIVERY":"false","LIVE_EMAIL_DELIVERY":"false"}
IMPORTER="custom-addons/codestra_klyrow_smtp/scripts/provision_klyrow_smtp.py"

class Blocked(RuntimeError): pass
class NeedsRecovery(RuntimeError): pass

def sha256(path):
    h=hashlib.sha256()
    with Path(path).open("rb") as f:
        for b in iter(lambda:f.read(1024*1024),b""): h.update(b)
    return h.hexdigest()

def root_regular(path):
    i=path.lstat()
    if not stat.S_ISREG(i.st_mode) or i.st_uid or i.st_gid or i.st_nlink!=1 or i.st_mode&0o022: raise Blocked(f"unsafe protected file: {path}")
    try: value=json.loads(path.read_text())
    except (UnicodeError,json.JSONDecodeError) as e: raise Blocked(f"malformed protected JSON: {path}") from e
    if not isinstance(value,dict): raise Blocked(f"protected JSON is not an object: {path}")
    return value

def validate_handoff(args,auth):
    expected={k:getattr(args,k) for k in ("repository","source_sha","artifact_kind","artifact_reference","artifact_digest","environment","action","evidence_output")}|{"target_host":args.validated_target_host}
    for k,v in expected.items():
        if auth.get(k)!=v: raise Blocked(f"dispatcher handoff mismatch: {k}")
    if args.validated_target_host not in {socket.gethostname(),socket.getfqdn()}: raise Blocked("adapter is not executing on the validated target")
    if not args.read_only or not args.deny_external_effects: raise Blocked("no-send controls are mandatory")
    if args.artifact_kind!="source-bundle": raise Blocked("Odoo adapter accepts only source-bundle artifacts")

def validate_recovery_evidence(auth,evidence_root=EVIDENCE_ROOT):
    binding={k:auth.get(k) for k in ("source_sha","artifact_digest","target_host","recovery_set_id")}
    rollback=auth.get("rollback_target",{}); binding|={"rollback_source_sha":rollback.get("source_sha"),"rollback_artifact_digest":rollback.get("artifact_digest")}
    if not isinstance(auth.get("recovery_set_id"),str) or auth["recovery_set_id"].startswith("PENDING"): raise Blocked("recovery set is unbound")
    for name in ("database","filestore","configuration","isolated_restore","rollback_rehearsal"):
        record=auth.get("recovery",{}).get(name,{}); digest=str(record.get("evidence_sha256",""))
        if record.get("status")!="PASS" or not digest.startswith(SHA256): raise Blocked(f"recovery evidence is incomplete: {name}")
        p=evidence_root/f"{digest.removeprefix(SHA256)}.json"
        if not p.is_file() or p.is_symlink() or sha256(p)!=digest.removeprefix(SHA256): raise Blocked(f"recovery evidence bytes unavailable: {name}")
        body=root_regular(p)
        if body.get("status")!="PASS" or body.get("scope")!=name or any(body.get(k)!=v for k,v in binding.items()): raise Blocked(f"recovery evidence content mismatch: {name}")

def acquire_artifact(reference,destination,deadline=None):
    deadline=deadline or time.monotonic()+MAX_OPERATION_SECONDS; parsed=urllib.parse.urlparse(reference)
    if parsed.scheme=="file": source=Path(urllib.request.url2pathname(parsed.path)); stream=source.open("rb") if source.is_file() and not source.is_symlink() else None
    elif parsed.scheme=="https" and parsed.hostname=="github.com" and parsed.path.startswith("/appolon1908-hue/Odoo/releases/download/"):
        stream=urllib.request.urlopen(urllib.request.Request(reference,headers={"User-Agent":"codestra-deploy-odoo/2"}),timeout=30)
        if stream.status!=200: stream.close(); raise Blocked("artifact download failed")
    else: raise Blocked("artifact reference is not an approved Odoo release location")
    if stream is None: raise Blocked("local artifact is unavailable or unsafe")
    total=0
    try:
        with stream, destination.open("xb") as out:
            while True:
                if time.monotonic()>deadline: raise Blocked("artifact acquisition deadline exceeded")
                block=stream.read(1024*1024)
                if not block: break
                total+=len(block)
                if total>MAX_ARCHIVE_BYTES: raise Blocked("artifact exceeds the maximum size")
                out.write(block)
    except Exception:
        destination.unlink(missing_ok=True); raise

def extract_verified(archive,destination,deadline=None):
    deadline=deadline or time.monotonic()+MAX_OPERATION_SECONDS; total=0
    try:
        with tarfile.open(archive,"r:gz") as bundle:
            members=bundle.getmembers()
            if not members or len(members)>MAX_MEMBERS: raise Blocked("artifact member count is invalid")
            for m in members:
                if time.monotonic()>deadline: raise Blocked("archive expansion deadline exceeded")
                p=Path(m.name)
                if p.is_absolute() or ".." in p.parts or m.issym() or m.islnk() or not(m.isfile() or m.isdir()): raise Blocked("artifact contains an unsafe member")
                total+=m.size
                if m.size>MAX_MEMBER_BYTES or total>MAX_EXPANDED_BYTES: raise Blocked("artifact expansion exceeds limits")
                out=destination/p; out.resolve().relative_to(destination.resolve())
                if m.isdir(): out.mkdir(parents=True,exist_ok=True)
                else:
                    out.parent.mkdir(parents=True,exist_ok=True); src=bundle.extractfile(m)
                    if src is None: raise Blocked("artifact member is unreadable")
                    with src,out.open("xb") as dst: shutil.copyfileobj(src,dst,1024*1024)
    except Exception:
        shutil.rmtree(destination,ignore_errors=True); raise

def verify_artifact(args,temporary):
    archive=temporary/"source.tar.gz"; release=temporary/"release"; release.mkdir()
    deadline=time.monotonic()+MAX_OPERATION_SECONDS; acquire_artifact(args.artifact_reference,archive,deadline)
    if SHA256+sha256(archive)!=args.artifact_digest: raise Blocked("artifact digest mismatch")
    extract_verified(archive,release,deadline)
    importer=release/IMPORTER
    if not importer.is_file() or importer.is_symlink(): raise Blocked("verified artifact lacks importer")
    return release,sha256(importer)

def load_target(path,host):
    v=root_regular(path); required={"schema","target_host","release_root","current_link","compose_directory","compose_files","service","database","modules","addon_mount","no_send_env","service_image","internal_networks","health_base_url","health"}
    if set(v)!=required or v.get("schema")!="codestra.odoo-deploy-target.v2" or v.get("target_host")!=host: raise Blocked("Odoo target configuration mismatch")
    for k in ("release_root","current_link","compose_directory"):
        p=Path(str(v[k]));
        if not p.is_absolute() or ".." in p.parts: raise Blocked(f"unsafe target path: {k}")
    if v.get("no_send_env")!=NO_SEND_KEYS: raise Blocked("target no-send policy mismatch")
    if "@sha256:" not in str(v["service_image"]) or not v["internal_networks"]: raise Blocked("target image/network policy incomplete")
    return v

def docker_compose(target,*cmd,check=True):
    argv=["docker","compose"]
    for f in target["compose_files"]: argv += ["-f",f]
    return subprocess.run([*argv,*cmd],cwd=target["compose_directory"],check=check,text=True,capture_output=True)

def validate_effective_compose(target,release_dir):
    doc=json.loads(docker_compose(target,"config","--format","json").stdout); svc=doc.get("services",{}).get(target["service"],{})
    env=svc.get("environment",{}); env=dict(x.split("=",1) for x in env if "=" in x) if isinstance(env,list) else env
    if svc.get("image")!=target["service_image"] or any(str(env.get(k,"")).lower()!=v for k,v in NO_SEND_KEYS.items()): raise Blocked("effective service image or no-send policy mismatch")
    networks=set(svc.get("networks",{})); approved=set(target["internal_networks"])
    if not networks or not networks<=approved or any(not doc.get("networks",{}).get(n,{}).get("internal") for n in networks): raise Blocked("effective service network is not egress-isolated")
    expected=f"{release_dir/'custom-addons'}:{target['addon_mount']}:ro"; volumes=svc.get("volumes",[])
    normalized=[f"{x.get('source')}:{x.get('target')}:{'ro' if x.get('read_only') else 'rw'}" if isinstance(x,dict) else x for x in volumes]
    if normalized.count(expected)!=1: raise Blocked("effective addon mount mismatch or shadowing")

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self,*_): return None

def check_health(target,health_paths):
    paths=[p for p in health_paths.split(",") if p]
    if set(paths)!=set(target["health"]): raise Blocked("health endpoint set differs from approved target")
    opener=urllib.request.build_opener(NoRedirect); results={}
    for path in paths:
        rule=target["health"][path]; url=target["health_base_url"].rstrip("/")+path
        try:
            with opener.open(url,timeout=rule.get("timeout_seconds",5)) as r:
                body=r.read(MAX_HEALTH_BYTES+1)
                if r.status!=rule["status"] or len(body)>MAX_HEALTH_BYTES: raise Blocked(f"unhealthy endpoint: {path}")
                value=json.loads(body)
                if value.get(rule["json_field"])!=rule["json_value"]: raise Blocked(f"incorrect health response: {path}")
        except (OSError,ValueError,json.JSONDecodeError) as e: raise Blocked(f"health endpoint failed: {path}") from e
        results[path]="PASS"
    return results

def readback(target,release_dir,source_sha,expected_importer,args):
    container=docker_compose(target,"ps","-q",target["service"]).stdout.strip()
    if not container: raise Blocked("Odoo container is absent")
    mounts=json.loads(subprocess.run(["docker","inspect",container,"--format","{{json .Mounts}}"],check=True,text=True,capture_output=True).stdout)
    matches=[m for m in mounts if m.get("Destination")==target["addon_mount"]]
    if len(matches)!=1 or matches[0].get("Source")!=str(release_dir/"custom-addons") or matches[0].get("RW") is not False: raise Blocked("running addon mount is altered or shadowed")
    observed=subprocess.run(["docker","exec",container,"sha256sum",f"{target['addon_mount']}/codestra_klyrow_smtp/scripts/provision_klyrow_smtp.py"],check=True,text=True,capture_output=True).stdout.split()[0]
    if observed!=expected_importer: raise Blocked("in-container importer differs from verified artifact")
    return {"source_sha":source_sha,"release_dir":str(release_dir),"container":container,"expected_importer_sha256":expected_importer,"observed_importer_sha256":observed,"health":check_health(target,args.health_paths),"no_send":True}

def deploy(args,auth,target):
    if args.action=="promote-production-readonly": raise Blocked("production promotion requires an independently verified traffic canary implementation")
    root=Path(target["release_root"]); release_dir=root/args.source_sha; current=Path(target["current_link"]); previous=current.resolve(strict=True) if current.is_symlink() else None
    if release_dir.exists() or (current.exists() and not current.is_symlink()): raise Blocked("immutable release or current pointer is unsafe")
    with tempfile.TemporaryDirectory(prefix="codestra-odoo-artifact-") as d:
        extracted,expected=verify_artifact(args,Path(d)); validate_effective_compose(target,extracted)
        root.mkdir(mode=0o750,parents=True,exist_ok=True); shutil.move(str(extracted),release_dir)
    validate_effective_compose(target,release_dir)
    nxt=current.with_name(current.name+".next"); nxt.symlink_to(release_dir); upgrade_started=False
    try:
        docker_compose(target,"stop",target["service"]); nxt.replace(current)
        upgrade_started=True; docker_compose(target,"run","--rm","--no-deps",target["service"],"odoo","-d",target["database"],"-u",target["modules"],"--stop-after-init","--no-http")
        docker_compose(target,"up","-d",target["service"])
        return readback(target,release_dir,args.source_sha,expected,args)
    except Exception as e:
        if upgrade_started: raise NeedsRecovery("upgrade may have changed database; old code was not restarted") from e
        if previous is not None:
            rb=current.with_name(current.name+".rollback"); rb.symlink_to(previous); rb.replace(current); docker_compose(target,"up","-d",target["service"],check=False)
        raise

def write_evidence(path,body):
    path=Path(path); path.parent.mkdir(parents=True,exist_ok=True)
    fd,tmp=tempfile.mkstemp(prefix=".codestra-evidence-",dir=path.parent)
    try:
        with os.fdopen(fd,"w") as f: json.dump(body,f,sort_keys=True); f.write("\n"); f.flush(); os.fsync(f.fileno())
        os.replace(tmp,path)
    finally: Path(tmp).unlink(missing_ok=True)

def parser():
    p=argparse.ArgumentParser(); p.add_argument("action",choices=("deploy-staging-readonly","certify-staging-readonly","promote-production-readonly"))
    for n in ("repository","source-sha","artifact-kind","artifact-reference","artifact-digest","environment","health-paths","evidence-output","authorization","validated-target-host"): p.add_argument(f"--{n}",required=True)
    for f in ("read-only","deny-external-effects","require-staging-certification","require-backup","require-isolated-restore","require-rollback-rehearsal"): p.add_argument(f"--{f}",action="store_true")
    p.add_argument("--canary-percent"); p.add_argument("--allowed-methods"); return p

def main(argv=None):
    args=parser().parse_args(argv)
    try:
        if os.geteuid()!=0: raise Blocked("adapter requires root dispatcher execution")
        auth=root_regular(Path(args.authorization)); validate_handoff(args,auth)
        if args.action=="promote-production-readonly": raise Blocked("production traffic canary is not implemented")
        validate_recovery_evidence(auth); target=load_target(CONFIG_ROOT/f"{args.validated_target_host}.json",args.validated_target_host)
        if args.action=="certify-staging-readonly":
            with tempfile.TemporaryDirectory(prefix="codestra-odoo-verify-") as d: _,expected=verify_artifact(args,Path(d))
            result=readback(target,Path(target["release_root"])/args.source_sha,args.source_sha,expected,args)
            write_evidence(args.evidence_output,{"status":"PASS",**result})
        else:
            write_evidence(args.evidence_output,{"status":"PREFLIGHT","source_sha":args.source_sha,"artifact_digest":args.artifact_digest})
            result=deploy(args,auth,target)
            try: write_evidence(args.evidence_output,{"status":"PASS",**result})
            except OSError as e: raise NeedsRecovery("deployment completed but durable PASS evidence could not be recorded") from e
        return 0
    except NeedsRecovery as e:
        try: write_evidence(args.evidence_output,{"status":"NEEDS_RECOVERY","reason":str(e),"source_sha":args.source_sha,"artifact_digest":args.artifact_digest})
        except OSError: pass
        print(f"ODOO_DEPLOYMENT_NEEDS_RECOVERY={e}",file=os.sys.stderr); return 2
    except (Blocked,OSError,subprocess.SubprocessError,tarfile.TarError,json.JSONDecodeError) as e:
        print(f"ODOO_DEPLOYMENT_BLOCKED={e}",file=os.sys.stderr); return 1

if __name__=="__main__": raise SystemExit(main())
