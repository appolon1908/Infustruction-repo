#cloud-config
hostname: codestra-stage6-staging-01
manage_etc_hosts: true
ssh_pwauth: false
disable_root: true
package_update: false
users:
  - default
  - name: codestra-stage6-deploy
    gecos: Codestra Stage 6 deployment identity
    groups: []
    shell: /bin/bash
    lock_passwd: true
  - name: codestra-staging-readonly
    gecos: Codestra restricted staging-readonly automation identity
    groups: []
    shell: /usr/sbin/nologin
    lock_passwd: true
  - name: codestra-stage6-admin
    gecos: Codestra Stage 6 host operator
    groups: [adm]
    shell: /bin/bash
    lock_passwd: true
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
write_files:
  - path: /etc/apt/sources.list.d/ubuntu.sources
    owner: root:root
    permissions: "0644"
    content: |
      Types: deb
      URIs: http://archive.ubuntu.com/ubuntu
      Suites: noble noble-updates noble-backports
      Components: main universe restricted multiverse
      Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

      Types: deb
      URIs: http://security.ubuntu.com/ubuntu
      Suites: noble-security
      Components: main universe restricted multiverse
      Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
  - path: /etc/apt/apt.conf.d/90codestra-stage6-proxy
    owner: root:root
    permissions: "0644"
    content: |
      Acquire::http::Proxy "http://${egress_gateway_private_ip}:3128";
      Acquire::https::Proxy "http://${egress_gateway_private_ip}:3128";
  - path: /etc/environment
    owner: root:root
    permissions: "0644"
    content: |
      HTTP_PROXY=http://${egress_gateway_private_ip}:3128
      HTTPS_PROXY=http://${egress_gateway_private_ip}:3128
      NO_PROXY=127.0.0.1,localhost,10.250.0.0/16
  - path: /etc/ssh/sshd_config.d/60-codestra-stage6.conf
    owner: root:root
    permissions: "0644"
    content: |
      PasswordAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes
      AllowUsers codestra-stage6-deploy codestra-staging-readonly codestra-stage6-admin

      Match User codestra-staging-readonly
          AuthenticationMethods publickey
          DisableForwarding yes
          PermitTTY no
          X11Forwarding no
          PermitUserRC no
          ForceCommand /usr/local/sbin/codestra-staging-readonly-force-command
  - path: /home/codestra-staging-readonly/.ssh/authorized_keys
    owner: codestra-staging-readonly:codestra-staging-readonly
    permissions: "0600"
    content: |
      restrict,command="/usr/local/sbin/codestra-staging-readonly-force-command",no-agent-forwarding,no-port-forwarding,no-pty,no-user-rc,no-X11-forwarding ${staging_readonly_operator_public_key}
  - path: /usr/local/sbin/codestra-staging-readonly-force-command
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      original="$(printenv SSH_ORIGINAL_COMMAND 2>/dev/null || true)"
      if [ "$original" != "status" ]; then
        echo "restricted staging operator: only status is available until a separately reviewed operator package is installed" >&2
        exit 2
      fi
      exec /usr/bin/sudo -n /usr/local/sbin/codestra-staging-readonly-operator status
  - path: /usr/local/sbin/codestra-staging-readonly-operator
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/python3
      """Fail-closed bootstrap for the restricted Stage 6 staging identity."""
      from __future__ import annotations

      import json
      import os
      import sys

      if os.geteuid() != 0:
          print("STAGING_OPERATOR=FAIL ERROR=root_required", file=sys.stderr)
          raise SystemExit(1)
      if sys.argv != [sys.argv[0], "status"]:
          print("STAGING_OPERATOR=BLOCKED ERROR=operator_package_not_installed", file=sys.stderr)
          raise SystemExit(2)
      print(
          json.dumps(
              {
                  "schema_version": 1,
                  "identity": "codestra-staging-readonly",
                  "mode": "bootstrap-status-only",
                  "deployment_authorized": False,
                  "candidate_installed": False,
                  "runtime_mutated": False,
                  "live_effects_enabled": False,
                  "next_required_authority": "signed-staging-operator-package",
              },
              separators=(",", ":"),
              sort_keys=True,
          )
      )
  - path: /etc/sudoers.d/90-codestra-staging-readonly
    owner: root:root
    permissions: "0440"
    content: |
      Defaults:codestra-staging-readonly !authenticate
      Defaults:codestra-staging-readonly secure_path=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      codestra-staging-readonly ALL=(root) NOPASSWD: /usr/local/sbin/codestra-staging-readonly-operator status
  - path: /etc/codestra/staging-readonly/bootstrap.json
    owner: root:root
    permissions: "0644"
    content: |
      {"schema_version":1,"identity":"codestra-staging-readonly","mode":"bootstrap-status-only","deployment_authorized":false,"candidate_installed":false,"runtime_mutated":false,"live_effects_enabled":false}
  - path: /etc/docker/daemon.json
    owner: root:root
    permissions: "0644"
    content: |
      {"icc":false,"live-restore":true,"log-driver":"local","no-new-privileges":true,"userland-proxy":false}
  - path: /etc/systemd/system/docker.service.d/proxy.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Service]
      Environment="HTTP_PROXY=http://${egress_gateway_private_ip}:3128"
      Environment="HTTPS_PROXY=http://${egress_gateway_private_ip}:3128"
      Environment="NO_PROXY=127.0.0.1,localhost,10.250.0.0/16"
  - path: /etc/systemd/system/docker.socket.d/deny-public.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Socket]
      ListenStream=
      ListenStream=/run/docker.sock
      SocketMode=0660
  - path: /etc/systemd/resolved.conf.d/60-codestra-stage6.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Resolve]
      DNS=${egress_gateway_private_ip}
      FallbackDNS=
  - path: /etc/systemd/timesyncd.conf.d/60-codestra-stage6.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Time]
      NTP=${egress_gateway_private_ip}
      FallbackNTP=
runcmd:
  - [sh, -ec, "for attempt in $(seq 1 180); do timeout 2 bash -c '</dev/tcp/${egress_gateway_private_ip}/3128' && break; test \"$attempt\" -lt 180 || exit 1; sleep 10; done"]
  - [sh, -ec, "for attempt in 1 2 3 4 5 6; do apt-get update && apt-get install -y apparmor apparmor-utils ca-certificates curl docker-compose-v2 docker.io git jq libseccomp2 runc unattended-upgrades && exit 0; sleep 20; done; exit 1"]
  - [install, -d, -m, "0755", /srv/codestra, /srv/codestra/releases, /srv/codestra/state]
  - [install, -d, -m, "0755", /etc/codestra]
  - [install, -d, -m, "0755", /etc/codestra/staging-readonly]
  - [install, -d, -m, "0700", -o, codestra-stage6-deploy, -g, codestra-stage6-deploy, /home/codestra-stage6-deploy/.ssh]
  - [install, -d, -m, "0700", -o, codestra-staging-readonly, -g, codestra-staging-readonly, /home/codestra-staging-readonly/.ssh]
  - [install, -d, -m, "0700", -o, codestra-stage6-admin, -g, codestra-stage6-admin, /home/codestra-stage6-admin/.ssh]
  - [cp, /root/.ssh/authorized_keys, /home/codestra-stage6-deploy/.ssh/authorized_keys]
  - [cp, /root/.ssh/authorized_keys, /home/codestra-stage6-admin/.ssh/authorized_keys]
  - [chown, "codestra-stage6-deploy:codestra-stage6-deploy", /home/codestra-stage6-deploy/.ssh/authorized_keys]
  - [chown, "codestra-staging-readonly:codestra-staging-readonly", /home/codestra-staging-readonly/.ssh/authorized_keys]
  - [chown, "codestra-stage6-admin:codestra-stage6-admin", /home/codestra-stage6-admin/.ssh/authorized_keys]
  - [chmod, "0600", /home/codestra-stage6-deploy/.ssh/authorized_keys]
  - [chmod, "0600", /home/codestra-staging-readonly/.ssh/authorized_keys]
  - [chmod, "0600", /home/codestra-stage6-admin/.ssh/authorized_keys]
  - [visudo, -cf, /etc/sudoers.d/90-codestra-staging-readonly]
  - [sshd, -t]
  - [apt-mark, hold, docker.io, containerd, runc, libseccomp2]
  - [systemctl, daemon-reload]
  - [systemctl, restart, systemd-resolved]
  - [systemctl, restart, systemd-timesyncd]
  - [systemctl, restart, ssh]
  - [systemctl, enable, --now, docker]
  - [sh, -c, "test ! -S /home/codestra-stage6-deploy/docker.sock && test ! -S /home/codestra-staging-readonly/docker.sock && test ! -S /home/codestra-stage6-admin/docker.sock"]
  - [sh, -c, "/usr/local/sbin/codestra-staging-readonly-operator status | jq -e '.deployment_authorized == false and .runtime_mutated == false and .live_effects_enabled == false' >/dev/null"]
final_message: "Codestra Stage 6 runtime prepared through controlled egress; restricted staging identity is status-only and applications remain undeployed."
